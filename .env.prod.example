# ============================================================
# MEDIFLOW — Self-Hosted Production Environment Template
# Copy to .env.prod (gitignored) and replace every CHANGE_ME value:
#   cp .env.prod.example .env.prod
#
# Generate strong random secrets with:
#   python3 -c "import secrets; print(secrets.token_hex(64))"
# ============================================================

# ---- Site & HTTPS (Caddy) ----
# Option 1 (Custom Domain with Automatic HTTPS via Let's Encrypt):
#   MEDIFLOW_SITE_ADDRESS=health.yourdomain.com
#   CORS_ORIGINS=https://health.yourdomain.com
#   COOKIE_SECURE=true
#
# Option 2 (Local Server / LAN / Tailscale IP over HTTP):
#   MEDIFLOW_SITE_ADDRESS=:80
#   CORS_ORIGINS=http://localhost,http://127.0.0.1
#   COOKIE_SECURE=false
MEDIFLOW_SITE_ADDRESS=:80
CORS_ORIGINS=http://localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
HTTP_PORT=80
HTTPS_PORT=443

# ---- PostgreSQL Credentials ----
POSTGRES_USER=mediflow
POSTGRES_PASSWORD=CHANGE_ME_strong_random_postgres_password
POSTGRES_DB=mediflow_db

# ---- Cryptographic Secrets (REQUIRED) ----
SECRET_KEY=CHANGE_ME_generate_64_byte_hex_secret_key
CSRF_SECRET=CHANGE_ME_generate_32_byte_hex_csrf_secret
SESSION_MAX_AGE_SECONDS=86400

# ---- Backend Performance & Uploads ----
UVICORN_WORKERS=2
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO

# ---- Local Ollama Models (Zero External API Keys Needed) ----
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=180
