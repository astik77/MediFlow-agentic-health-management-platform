# ============================================================
# MEDIFLOW — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_NAME=MediFlow
APP_VERSION=0.1.0
DEBUG=true

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://mediflow:mediflow_dev_password@localhost:5432/mediflow_db
DATABASE_URL_SYNC=postgresql+psycopg2://mediflow:mediflow_dev_password@localhost:5432/mediflow_db

# ---- PostgreSQL (Docker) ----
POSTGRES_USER=mediflow
POSTGRES_PASSWORD=mediflow_dev_password
POSTGRES_DB=mediflow_db
POSTGRES_PORT=5432

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_string_at_least_64_chars
SESSION_MAX_AGE_SECONDS=86400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET=CHANGE_ME_another_secure_random_string

# ---- Password Hashing ----
# Argon2id parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ---- File Upload ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# ---- AI Provider Configuration ----
# Primary: Ollama (local — default, free)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# Optional: Gemini (requires API key — disabled by default for real patient data)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# Optional: Grok (requires API key — disabled by default for real patient data)
GROK_ENABLED=false
GROK_API_KEY=
GROK_MODEL=grok-beta

# ---- External AI Safety ----
# When false, real patient data is NEVER sent to external providers
ALLOW_EXTERNAL_AI_FOR_REAL_DATA=false
# Use only synthetic/test data with external APIs
EXTERNAL_AI_SYNTHETIC_ONLY=true

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MediFlow
NEXT_PUBLIC_APP_ENV=development

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
